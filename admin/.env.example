# Copy to admin/.env and fill in. Never commit .env.
# This app does not read VITE_ variables. Secrets stay on the server.

# Required before sign-in works. Production refuses to boot without them.
APP_ORIGIN=http://127.0.0.1:8787
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# At least 32 characters. Example: openssl rand -base64 32
SESSION_SECRET=

# Optional. Collect stays off until this is set (16+ characters).
# The key is not an admin password. It can only submit bounded page events.
INGEST_KEY=
# Optional. Without it, pageviews can be stored but estimated uniques stay unavailable.
VISITOR_HASH_SALT=

PORT=8787
NODE_ENV=development

# Local design review only. Ignored when NODE_ENV=production.
# 1 = labeled fixture numbers. empty = labeled empty dashboard.
# ADMIN_DEMO=1

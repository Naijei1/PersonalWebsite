  "narrative": {
    "northStar": "A Space Connected",
    "overview": "Gnarly opens inside a dark procedural building: a scan becomes three connected floors, the camera returns through the doorway, and a blue route appears. A visible headline and demo action give this cinematic world a clear purpose. White editorial sections then explain the product with the same precise typography and restrained spatial diagrams.",
    "keyCharacteristics": [
      "Full-bleed navy environment and luminous blue routes.",
      "Visible Inter Variable headline and decisive demo action.",
      "Three open workflow chapters with illustrative diagrams.",
      "Compact native controls and quiet white reading surfaces."
    ],
    "rules": [
      {
        "name": "Route",
        "body": "Concentrate luminous blue in the navigation path, spatial accents, and interaction cues.",
        "section": "colors"
      },
      {
        "name": "Spatial Depth",
        "body": "Let the environment carry depth; keep reading surfaces flat and clear.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep the headline and demo action available throughout the cinematic journey.",
      "Do retain keyboard access, reduced motion, honest form feedback, and illustrative disclosures."
    ],
    "donts": [
      "Don't introduce personal-domain labels, student or school branding, fake floor tabs, or unsupported product claims.",
      "Don't loop the WebGL journey indefinitely or hide workflow content behind an accordion."
    ]
